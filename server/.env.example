# =============================================================================
# KC CHAT — Django Server Environment Variables
# =============================================================================
# Copy this file to server/.env and fill in your real values.
# NEVER commit server/.env to git — it contains secret credentials.
# =============================================================================

# -------------------------
# RESEND SMTP CONFIGURATION
# -------------------------
# Get your API key from: https://resend.com ? API Keys
# SMTP Host: smtp.resend.com (always this)
# SMTP Username: resend (always this literal word)
# SMTP Password: your Resend API key (re_xxxxxxxxxxxx)
# Port 465 = SSL (faster), Port 587 = TLS

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=465
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=re_YOUR_RESEND_API_KEY_HERE
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False

# Sender address:
#   Option A (instant, no DNS): onboarding@resend.dev  (Resend test address)
#   Option B (your domain):     noreply@yourdomain.com (requires DNS verification in Resend)
DEFAULT_FROM_EMAIL=KC Chat <onboarding@resend.dev>

# -------------------------
# DJANGO SECRET KEY
# -------------------------
# Generate a strong key for production: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=django-insecure-replace-this-in-production

# -------------------------
# DEBUG
# -------------------------
DEBUG=True

# CONNECTA SUPABASE CONFIGURATION (OPTIONAL)
# If provided, Connecta connects directly to your Supabase Cloud PostgreSQL database, Storage, and Realtime!
# If left blank or unconfigured, Connecta runs automatically using the instant local BroadcastChannel real-time engine.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

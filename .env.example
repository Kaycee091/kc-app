# CONNECTA SUPABASE CONFIGURATION (OPTIONAL)
# If provided, Connecta connects directly to your Supabase Cloud PostgreSQL database, Storage, and Realtime!
# If left blank or unconfigured, Connecta runs automatically using the instant local BroadcastChannel real-time engine.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# DJANGO BACKEND & EMAIL CONFIGURATION
# Email backend configuration for email verification
# For development/testing without real SMTP:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For real SMTP production (e.g. Gmail, Sendgrid, Postmark):
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Connecta <noreply@connecta.app>
